# Copy to .env and fill in real values. Never commit the real .env — it's gitignored.
# See HANDOFF.md for where each of these comes from and known gotchas.

PORT=3000

# Google Gemini (order parsing + FAQ answers)
GOOGLE_API_KEY=

# Google Sheets (order log + menu/availability + customer profiles)
# Service account must have edit access to the sheet at GOOGLE_SHEETS_ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEETS_ID=

# Chakra (WhatsApp Business / Meta Cloud API pass-through)
# CHAKRA_PHONE_NUMBER_ID must be the PHONE NUMBER's own ID, NOT the WABA ID —
# Chakra's "WhatsApp Phone Numbers" table shows both side by side and it's
# easy to grab the wrong one. See HANDOFF.md for the full story.
CHAKRA_API_KEY=
CHAKRA_PLUGIN_ID=
CHAKRA_PHONE_NUMBER_ID=
CHAKRA_API_VERSION=v24.0

# Webhook security
WEBHOOK_VERIFY_TOKEN=
CHAKRA_WEBHOOK_SECRET=

# Kitchen dashboard (/kitchen) — a live order queue for a tablet in the shop.
# Staff enter this password once per device; it's remembered for a year.
# The page shows customer phone numbers and delivery addresses and can
# trigger real WhatsApp status messages, so if this is unset the dashboard
# refuses to serve at all rather than defaulting to public. Use a long,
# random value.
KITCHEN_PASSWORD=

# Manager dashboard (/manager) — sales, history, top items, customers.
# A SEPARATE password from the kitchen on purpose: kitchen staff need the
# order queue, they don't need revenue totals or the customer list.
MANAGER_PASSWORD=

# Optional / dev only
# DEBUG_REPLIES=1      # logs every outbound reply to console
# BOT_DRY_RUN=1         # set by test/replay.test.js only — never in production
