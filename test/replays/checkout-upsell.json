{
  "name": "checkout-upsell-is-offered-once-and-never-blocks-checkout",
  "from": "19990000031",
  "turns": [
    {
      "in": "1",
      "expectStep": "menu"
    },
    {
      "in": "1",
      "expectStep": "item"
    },
    {
      "in": "1",
      "expectStep": "item",
      "expectCartLength": 1
    },
    {
      "comment": "checkout reads the order back first; the offer rides alongside the mode buttons when the amounts are settled — it is still not a step",
      "in": "done",
      "expectStep": "qtyrecap"
    },
    {
      "buttonId": "qty:each",
      "expectStep": "mode",
      "expectCartLength": 1,
      "expectReplyContains": "Add *",
      "comment": "the offer must actually APPEAR here — asserting only that add1:/no_thanks work would pass even if it were never shown"
    },
    {
      "comment": "declining leaves the cart alone and keeps them at mode",
      "buttonId": "no_thanks",
      "expectStep": "mode",
      "expectCartLength": 1
    },
    {
      "comment": "accepting adds exactly one and stays at mode",
      "buttonId": "add1:2:1",
      "expectStep": "mode",
      "expectCartLength": 2
    },
    {
      "comment": "a sold-out suggestion must not be addable",
      "markSoldOut": [
        "2.2"
      ],
      "buttonId": "add1:2:2",
      "expectStep": "mode",
      "expectCartLength": 2
    },
    {
      "clearSoldOut": true
    },
    {
      "comment": "checkout still completes normally",
      "buttonId": "pickup",
      "expectStep": "confirm"
    }
  ]
}
